        </material>
        </visual>
      </link>
    </model>  -->

    <!-- LEFT WALL -->
    <model name="wall_left">
      <static>true</static>
      <pose>-2.5 0 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 5 0.6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 5 0.6</size></box></geometry>
          <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
        </material>
        </visual>
      </link>
    </model>

    <!-- RIGHT WALL -->
