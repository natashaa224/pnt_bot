<?xml version="1.0" ?>
<sdf version="1.5">
  <world name="default">

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <include>
      <uri>model://sun</uri>
    </include>

    <!-- FRONT WALL -->
    <model name="wall_front">
      <static>true</static>
      <pose>0 2.5 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>5 0.2 0.6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>5 0.2 0.6</size></box></geometry>
          <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
        </material>
        </visual>
      </link>
    </model>

   <!-- BACK WALL -->
 <!--    <model name="wall_back">
