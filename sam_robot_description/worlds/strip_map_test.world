<?xml version="1.0" ?>
<!--
  strip_map_test.world
  =====================================================================
  Minimal environment for strip map / fixture detection testing.

  SCENARIO
  --------
  Single wall runs along Y axis (face at y = +12.5, thickness 0.15m,
  so wall centre-plane at y = 12.575).
  Wall spans x = -6.0 .. +6.0  (12m wide), height 3.0m.

  Window (no-paint zone):
    Centre: x = -1.3,  y = 12.5  (inner face of wall)
    Width:  1.0m   → x = -1.8 .. -0.8
    Sill:   z = 0.9m
    Head:   z = 1.9m   (opening height = 1.0m)

  Robot spawn (set in your launch / initial_pose):
    x = 0.0,  y = 11.7,  yaw = pi/2  (facing wall)
    Wall standoff = 12.5 - 11.7 = 0.8m

  Strip geometry (for reference):
    Strip width  = 0.203m
    Robot centre x = 0.0
    Window near edge (x_right) = -0.8m  →  0.8 / 0.203 ≈ 3.9  → ~4 full-ON strips
    Window width 1.0m  →  1.0 / 0.203 ≈ 4.9  → ~5 windowed strips
    Then full-ON again to wall left end

  Camera params used for this test (base_link frame):
    xyz:  0.096, 0.05, 1.134
    rpy:  0.0,   0.0,  -22.9 deg  (yaw only, looking slightly toward window)

  Wall segments (split around window opening):
    seg_L  : x = -6.0  .. -1.8   w = 4.2   cx = -3.9
    win_bot: x = -1.8  .. -0.8   w = 1.0   z = 0 .. 0.9   (below sill)
    win_top: x = -1.8  .. -0.8   w = 1.0   z = 1.9 .. 3.0 (above head)
    seg_R  : x = -0.8  .. +6.0   w = 6.8   cx = +2.6
  =====================================================================
-->
<sdf version='1.6'>
  <world name='strip_map_test'>

    <!-- ====== PHYSICS ====== -->
    <gravity>0 0 -9.8</gravity>
    <physics name='default_physics' default='0' type='ode'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- ====== SCENE ====== -->
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.5 0.5 0.5 1</background>
      <shadows>1</shadows>
    </scene>

    <!-- ====== SUN ====== -->
    <light name='sun' type='directional'>
      <cast_shadows>1</cast_shadows>
      <pose>0 0 10 0 -0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- ====== GROUND PLANE ====== -->
    <model name='ground_plane'>
      <static>1</static>
      <link name='link'>
        <collision name='collision'>
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name='visual'>
          <cast_shadows>0</cast_shadows>
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Grey</name>
          </script></material>
        </visual>
      </link>
    </model>

    <!--
    ================================================================
      MAIN WALL  (single wall facing -Y, inner face at y = +12.5)
      Wall centre-plane at y = 12.575
      Total span: x = -6.0 .. +6.0,  height = 3.0m
      Window opening: x = -1.8 .. -0.8,  z = 0.9 .. 1.9

      Split into 4 solid segments:
        seg_L    solid left of window
        win_bot  below window sill
        win_top  above window head
        seg_R    solid right of window
    ================================================================
    -->
    <model name='test_wall'>
      <static>1</static>
      <pose>0 0 0 0 0 0</pose>
      <link name='link'>

        <!-- seg_L: x=-6.0..-1.8  width=4.2  cx=-3.9 -->
        <visual name='seg_L'>
          <pose>-3.9 12.575 1.5 0 0 0</pose>
          <geometry><box><size>4.2 0.15 3.0</size></box></geometry>
          <material>
            <ambient>0.80 0.78 0.74 1</ambient>
            <diffuse>0.80 0.78 0.74 1</diffuse>
            <specular>0.02 0.02 0.02 1</specular>
          </material>
        </visual>
        <collision name='cL'>
          <pose>-3.9 12.575 1.5 0 0 0</pose>
          <geometry><box><size>4.2 0.15 3.0</size></box></geometry>
        </collision>

        <!-- win_bot: below sill  x=-1.8..-0.8  w=1.0  z=0..0.9  cz=0.45 -->
        <visual name='win_bot'>
          <pose>-1.3 12.575 0.45 0 0 0</pose>
          <geometry><box><size>1.0 0.15 0.9</size></box></geometry>
          <material>
            <ambient>0.80 0.78 0.74 1</ambient>
            <diffuse>0.80 0.78 0.74 1</diffuse>
            <specular>0.02 0.02 0.02 1</specular>
          </material>
        </visual>
        <collision name='cWb'>
          <pose>-1.3 12.575 0.45 0 0 0</pose>
          <geometry><box><size>1.0 0.15 0.9</size></box></geometry>
        </collision>

        <!-- win_top: above head  x=-1.8..-0.8  w=1.0  z=1.9..3.0  cz=2.45 -->
        <visual name='win_top'>
          <pose>-1.3 12.575 2.45 0 0 0</pose>
          <geometry><box><size>1.0 0.15 1.1</size></box></geometry>
          <material>
            <ambient>0.80 0.78 0.74 1</ambient>
            <diffuse>0.80 0.78 0.74 1</diffuse>
            <specular>0.02 0.02 0.02 1</specular>
          </material>
        </visual>
        <collision name='cWt'>
          <pose>-1.3 12.575 2.45 0 0 0</pose>
          <geometry><box><size>1.0 0.15 1.1</size></box></geometry>
        </collision>

        <!-- seg_R: x=-0.8..+6.0  width=6.8  cx=+2.6 -->
        <visual name='seg_R'>
          <pose>2.6 12.575 1.5 0 0 0</pose>
          <geometry><box><size>6.8 0.15 3.0</size></box></geometry>
          <material>
            <ambient>0.80 0.78 0.74 1</ambient>
            <diffuse>0.80 0.78 0.74 1</diffuse>
            <specular>0.02 0.02 0.02 1</specular>
          </material>
        </visual>
        <collision name='cR'>
          <pose>2.6 12.575 1.5 0 0 0</pose>
          <geometry><box><size>6.8 0.15 3.0</size></box></geometry>
        </collision>

      </link>
    </model>

    <!--
    ================================================================
      WINDOW FRAME (dark timber surround, purely visual)
      Opening: x=-1.8..-0.8, z=0.9..1.9
      Frame thickness: 0.06m, depth: 0.10m
      Placed on inner face of wall (y=12.5, frame front face flush)
    ================================================================
    -->
    <model name='window_frame'>
      <static>1</static>
      <pose>0 0 0 0 0 0</pose>
      <link name='link'>

        <!-- top rail  z=1.9 -->
        <visual name='top'>
          <pose>-1.3 12.47 1.93 0 0 0</pose>
          <geometry><box><size>1.12 0.10 0.06</size></box></geometry>
          <material>
            <ambient>0.22 0.16 0.10 1</ambient>
            <diffuse>0.28 0.20 0.12 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>

        <!-- bottom rail  z=0.9 -->
        <visual name='bot'>
          <pose>-1.3 12.47 0.87 0 0 0</pose>
          <geometry><box><size>1.12 0.10 0.06</size></box></geometry>
          <material>
            <ambient>0.22 0.16 0.10 1</ambient>
            <diffuse>0.28 0.20 0.12 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>

        <!-- left stile  x=-1.8 -->
        <visual name='left'>
          <pose>-1.83 12.47 1.4 0 0 0</pose>
          <geometry><box><size>0.06 0.10 1.0</size></box></geometry>
          <material>
            <ambient>0.22 0.16 0.10 1</ambient>
            <diffuse>0.28 0.20 0.12 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>

        <!-- right stile  x=-0.8 -->
        <visual name='right'>
          <pose>-0.77 12.47 1.4 0 0 0</pose>
          <geometry><box><size>0.06 0.10 1.0</size></box></geometry>
          <material>
            <ambient>0.22 0.16 0.10 1</ambient>
            <diffuse>0.28 0.20 0.12 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>

        <!-- mid rail (horizontal divider at z=1.4) -->
        <visual name='mid'>
          <pose>-1.3 12.47 1.4 0 0 0</pose>
          <geometry><box><size>1.0 0.08 0.04</size></box></geometry>
          <material>
            <ambient>0.22 0.16 0.10 1</ambient>
            <diffuse>0.28 0.20 0.12 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>

        <!-- glass pane (light blue, slightly transparent-ish) -->
        <visual name='glass'>
          <pose>-1.3 12.50 1.4 0 0 0</pose>
          <geometry><box><size>0.94 0.02 0.94</size></box></geometry>
          <material>
            <ambient>0.55 0.65 0.75 0.6</ambient>
            <diffuse>0.55 0.65 0.75 0.6</diffuse>
            <specular>0.8 0.8 0.9 1</specular>
          </material>
        </visual>

      </link>
    </model>

    <!--
    ================================================================
      FLOOR MARKER — thin coloured strip showing strip boundaries
      on the floor, purely for visual reference during testing.
      Strips at x = 0, -0.203, -0.406 ... aligned with robot travel.
      (Optional — comment out if clutters view)
    ================================================================
    -->

    <!-- Strip boundary markers on floor (10 strips, 0.203m each, starting x=0 going -x) -->
    <model name='strip_marker_0'><static>1</static><pose>-0.101 11.9 0.002 0 0 0</pose>
      <link name='link'><visual name='v'><geometry><box><size>0.200 0.05 0.004</size></box></geometry>
        <material><ambient>0.2 0.8 0.2 1</ambient><diffuse>0.2 0.8 0.2 1</diffuse></material></visual></link></model>

    <model name='strip_marker_1'><static>1</static><pose>-0.304 11.9 0.002 0 0 0</pose>
      <link name='link'><visual name='v'><geometry><box><size>0.200 0.05 0.004</size></box></geometry>
        <material><ambient>0.2 0.8 0.2 1</ambient><diffuse>0.2 0.8 0.2 1</diffuse></material></visual></link></model>

    <model name='strip_marker_2'><static>1</static><pose>-0.507 11.9 0.002 0 0 0</pose>
      <link name='link'><visual name='v'><geometry><box><size>0.200 0.05 0.004</size></box></geometry>
        <material><ambient>0.2 0.8 0.2 1</ambient><diffuse>0.2 0.8 0.2 1</diffuse></material></visual></link></model>

    <model name='strip_marker_3'><static>1</static><pose>-0.710 11.9 0.002 0 0 0</pose>
      <link name='link'><visual name='v'><geometry><box><size>0.200 0.05 0.004</size></box></geometry>
        <material><ambient>0.2 0.8 0.2 1</ambient><diffuse>0.2 0.8 0.2 1</diffuse></material></visual></link></model>

    <!-- strips 4-8 enter window zone: orange markers -->
    <model name='strip_marker_4'><static>1</static><pose>-0.913 11.9 0.002 0 0 0</pose>
      <link name='link'><visual name='v'><geometry><box><size>0.200 0.05 0.004</size></box></geometry>
        <material><ambient>1.0 0.5 0.0 1</ambient><diffuse>1.0 0.5 0.0 1</diffuse></material></visual></link></model>

    <model name='strip_marker_5'><static>1</static><pose>-1.116 11.9 0.002 0 0 0</pose>
      <link name='link'><visual name='v'><geometry><box><size>0.200 0.05 0.004</size></box></geometry>
        <material><ambient>1.0 0.5 0.0 1</ambient><diffuse>1.0 0.5 0.0 1</diffuse></material></visual></link></model>

    <model name='strip_marker_6'><static>1</static><pose>-1.319 11.9 0.002 0 0 0</pose>
      <link name='link'><visual name='v'><geometry><box><size>0.200 0.05 0.004</size></box></geometry>
        <material><ambient>1.0 0.5 0.0 1</ambient><diffuse>1.0 0.5 0.0 1</diffuse></material></visual></link></model>

    <model name='strip_marker_7'><static>1</static><pose>-1.522 11.9 0.002 0 0 0</pose>
      <link name='link'><visual name='v'><geometry><box><size>0.200 0.05 0.004</size></box></geometry>
        <material><ambient>1.0 0.5 0.0 1</ambient><diffuse>1.0 0.5 0.0 1</diffuse></material></visual></link></model>

    <model name='strip_marker_8'><static>1</static><pose>-1.725 11.9 0.002 0 0 0</pose>
      <link name='link'><visual name='v'><geometry><box><size>0.200 0.05 0.004</size></box></geometry>
        <material><ambient>1.0 0.5 0.0 1</ambient><diffuse>1.0 0.5 0.0 1</diffuse></material></visual></link></model>

    <!-- strip 9 back to full ON: green -->
    <model name='strip_marker_9'><static>1</static><pose>-1.928 11.9 0.002 0 0 0</pose>
      <link name='link'><visual name='v'><geometry><box><size>0.200 0.05 0.004</size></box></geometry>
        <material><ambient>0.2 0.8 0.2 1</ambient><diffuse>0.2 0.8 0.2 1</diffuse></material></visual></link></model>

  </world>
</sdf>
