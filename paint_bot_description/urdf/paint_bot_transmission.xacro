<?xml version="1.0" ?>
<robot name="transmission_properties" xmlns:xacro="http://ros.org/wiki/xacro">
    <xacro:macro 
        name="paint_bot_transmission" 
        params="left_wheel right_wheel height_paint_position paint_spray_gun ">

        <ros2_control name="PaintBotSystem" type="system">
            <hardware>
                <!-- Gazebo simulation plugin -->
                <plugin>gazebo_ros2_control/GazeboSystem</plugin>
            </hardware>

            <!-- LEFT WHEEL -->
            <joint name="${left_wheel}">
                <command_interface name="velocity"/>
                <state_interface name="velocity"/>
                <state_interface name="position"/>
            </joint>

            <!-- RIGHT WHEEL -->
            <joint name="${right_wheel}">
                <command_interface name="velocity"/>
                <state_interface name="velocity"/>
                <state_interface name="position"/>
            </joint>

            <joint name="zAxis_joint">
                <command_interface name="position"/>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
            </joint>

            <joint name="wrist_joint">
                <command_interface name="position"/>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
            </joint>

        </ros2_control>
    </xacro:macro>

</robot>
