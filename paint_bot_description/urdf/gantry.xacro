<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="gantry" params="parent xyz rpy">

        <!-- ============================================================== -->
        <!-- Auxiliary Extension Link                                        -->
        <!-- This is the outer gantry extension carriage (circled in red).  -->
        <!-- It is a separate prismatic stage mounted on the base frame.     -->
        <!-- It ONLY moves when the painting target exceeds the normal       -->
        <!-- gantry's 1.2 m reach. During normal painting it stays at 0.0.  -->
        <!-- ============================================================== -->
        <link name="extension_link">
            <inertial>
                <origin xyz="0 0 0.1" rpy="0 0 0" />
                <mass value="1.5" />
                <inertia ixx="0.02"
                        ixy="0"
                        ixz="0"
                        iyy="0.02"
                        iyz="0"
                        izz="0.005" />
            </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <!-- Represent extension carriage as a thin box -->
                    <box size="0.08 0.06 0.30" />
                </geometry>
                <material name="ext_orange">
                    <color rgba="0.9 0.5 0.1 1" />
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 0.1" rpy="0 0 0" />
                <geometry>
                    <box size="0.08 0.06 0.30" />
                </geometry>
            </collision>
        </link>

        <!-- Auxiliary Extension Joint (independent prismatic stage, +Z axis) -->
        <!-- This joint moves ONLY when strip_z_max > z_max_m (normal gantry limit). -->
        <!-- It must NOT be coupled to zAxis_joint or wrist_joint motion.             -->
        <joint name="extension_joint" type="prismatic">
            <origin xyz="${xyz}" rpy="${rpy}" />
            <parent link="${parent}" />
            <child link="extension_link" />
            <axis xyz="0 0 1" />
            <limit lower="0.0"
                   upper="0.6"
                   effort="400"
                   velocity="0.5" />
            <dynamics damping="10.0" friction="2.0" />
        </joint>

        <!-- Height Adj Link — child of extension_link so it benefits from extra reach -->
        <link name="height_adj_link">
            <inertial>
                <origin xyz="0.022628 -0.00010699 0.64618" rpy="0 0 0" />
                <mass value="2" />
                <inertia ixx="0.41681"
                        ixy="-6.9684E-08"
                        ixz="5.4046E-07"
                        iyy="0.41486"
                        iyz="9.5071E-14"
                        izz="0.0033962" />
            </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <mesh filename="package://paint_bot_description/meshes/height_adj_link.STL" />
                </geometry>
                <material name="height_adj_gray">
                    <color rgba="0.75294 0.75294 0.75294 1" />
                </material>
            </visual>
            <!-- Tiny collision sphere to prevent ground dragging and avoid Gazebo segfault -->
            <collision>
                <origin xyz="0 0 0.6" rpy="0 0 0" />
                <geometry>
                    <sphere radius="0.001" />
                </geometry>
            </collision>
        </link>

        <!-- Height Adj Joint — parent is now extension_link so combined reach =
             extension_joint position + zAxis_joint position (up to 1.2 m + 0.6 m = 1.8 m) -->
        <joint name="zAxis_joint" type="prismatic">
            <origin xyz="0 0 0" rpy="0 0 0" />
            <parent link="extension_link" />
            <child link="height_adj_link" />
            <axis xyz="0 0 1" />
            <limit lower="0"
                upper="1.2"
                effort="500"
                velocity="2.0" />
        </joint>

        <!-- Paint Spray Gun Link -->
        <link name="paint_spray_gun_link">
            <inertial>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <mass value="1" />
                <inertia ixx="4.2e-4"
                        ixy="0"
                        ixz="0"
                        iyy="3.5e-3"
                        iyz="0"
                        izz="3.5e-3" />
            </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <mesh filename="package://paint_bot_description/meshes/paint_spray_gun_link.STL" />
                </geometry>
                <material name="white"/>
            </visual>
            <!-- Tiny collision sphere to prevent ground dragging and avoid Gazebo segfault -->
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <sphere radius="0.001" />
                </geometry>
            </collision>
        </link>

        <!-- Paint Spray Gun Joint (Wrist Pitch Servo) -->
        <joint name="wrist_joint" type="revolute">
            <origin xyz="0.0965 0 0.033" rpy="0 0 0" />
            <parent link="height_adj_link" />
            <child link="paint_spray_gun_link" />
            <axis xyz="0 1 0" />
            <limit lower="-0.8"
                upper="0.8"
                effort="50"
                velocity="1.0" />
        </joint>

        <!-- Gazebo joint properties for implicit solver stability to prevent payload vibration -->
        <gazebo reference="extension_joint">
            <implicitSpringDamper>true</implicitSpringDamper>
        </gazebo>
        <gazebo reference="zAxis_joint">
            <implicitSpringDamper>true</implicitSpringDamper>
        </gazebo>
        <gazebo reference="wrist_joint">
            <implicitSpringDamper>true</implicitSpringDamper>
        </gazebo>

        <!-- Gazebo properties for extension link -->
        <gazebo reference="extension_link">
            <material>Gazebo/Orange</material>
            <gravity>0</gravity>
        </gazebo>

        <!-- Gazebo properties for Gantry -->
        <gazebo reference="height_adj_link">
            <material>Gazebo/Grey</material>
            <gravity>0</gravity>
        </gazebo>

        <gazebo reference="paint_spray_gun_link">
            <material>Gazebo/Black</material>
            <gravity>0</gravity>
        </gazebo>

    </xacro:macro>

</robot>
