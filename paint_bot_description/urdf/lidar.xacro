<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">


<!-- Lidar Link -->
    <link name="lidar_link">
        <!-- <inertial>
            <origin xyz="-0.012569 0.002836 0.010458" rpy="0 0 0" />
            <mass value="0.15" /> 
            <inertia ixx="1.2414E-05"
                    ixy="4.7235E-07"
                    ixz="2.1139E-08"
                    iyy="1.2922E-05"
                    iyz="-2.6102E-08"
                    izz="2.3177E-05" />
        </inertial> -->

        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <!-- <mesh filename="package://paint_bot_description/meshes/lidar_link.STL" /> -->
                <cylinder radius="0.045" length="0.08"/>
            </geometry>
            <material name="light_black"/>
        </visual>

        <!-- <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://paint_bot_description/meshes/lidar_link.STL" />
            </geometry>
        </collision> -->

        <collision>
        <geometry>
            <cylinder radius="0.05" length="0.04"/>
        </geometry>
        </collision>
    </link>


     
    <!-- Lidar Joint -->
    <joint name="lidar_joint" type="fixed">
        <!-- <origin xyz="0.28397 -0.16451 0.65" rpy="0 0 3.14159" /> -->
        <origin xyz="0.195 -0.147 0.65" rpy="0 0 3.14159" />
        <parent link="base_link" />
        <child link="lidar_link" />
        <axis xyz="0 0 0" />
    </joint>

    <gazebo reference="lidar_link">
        <material>Gazebo/Black</material>

        <sensor name="laser" type="ray">
            <pose> 0 0 0 0 0 0 </pose>
            <visualize>false</visualize>
            <update_rate>10</update_rate>
            <ray>
                <scan>
                    <horizontal>
                        <samples>720</samples>
                        <min_angle>-3.141593</min_angle>
                        <max_angle>3.141593</max_angle>
                        
                    </horizontal>
                </scan>
                <range>
                <min>0.120000</min>
                <max>12.0</max>
                <resolution>0.015000</resolution>
                 </range>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.01</stddev>
                </noise>
            </ray>
            <plugin name="laser_controller" filename="libgazebo_ros_ray_sensor.so">
                <ros>
                <remapping>~/out:=/scan</remapping>
                </ros>
                <output_type>sensor_msgs/LaserScan</output_type>
                <frame_name>lidar_link</frame_name>
            </plugin>
        </sensor>
    </gazebo>
</robot>