<?xml version="1.0" ?>
<robot name="paint_bot" xmlns:xacro="http://ros.org/wiki/xacro">

    <!-- Args -->
    <xacro:arg name="sim" default="classic"/>
    <xacro:property name="sim" value="$(arg sim)"/>

    <xacro:arg name="attach_gantry" default="true"/>
    <xacro:arg name="attach_sensors" default="false"/>

    <!-- Include Modular URDF Files -->
    <xacro:include filename="$(find paint_bot_description)/urdf/paint_bot_color.xacro"/>
    <xacro:include filename="$(find paint_bot_description)/urdf/base.xacro"/>
    <xacro:include filename="$(find paint_bot_description)/urdf/diff_drive.xacro"/>
    <xacro:include filename="$(find paint_bot_description)/urdf/caster.xacro"/>
    <xacro:include filename="$(find paint_bot_description)/urdf/gantry.xacro"/>
    <!-- <xacro:include filename="$(find paint_bot_description)/urdf/camera1.xacro"/> -->
    <xacro:include filename="$(find paint_bot_description)/urdf/paint_bot_gazebo.xacro"/>
    <xacro:include filename="$(find paint_bot_description)/urdf/paint_bot_transmission.xacro"/>
    <xacro:include filename="$(find paint_bot_description)/urdf/lidar.xacro"/>

    <!-- Instantiate Driven Wheels with firm ground contact -->
    <xacro:driven_wheel name="left"  parent="base_link" xyz="0 0.288 -0.010" rpy="0 0 0" y_reflect="1"/>
    <xacro:driven_wheel name="right" parent="base_link" xyz="0 -0.288 -0.010" rpy="0 0 0" y_reflect="-1"/>

    <!-- Instantiate Casters balanced at exact ground contact height -->
    <xacro:caster name="front_right" parent="base_link" plate_xyz="0.375 -0.243 -0.040" wheel_xyz="0.025 0 -0.040"/>
    <xacro:caster name="front_left"  parent="base_link" plate_xyz="0.375 0.243 -0.040"  wheel_xyz="0.025 0 -0.040"/>
    <xacro:caster name="rear_right"  parent="base_link" plate_xyz="-0.375 -0.243 -0.040" wheel_xyz="0.025 0 -0.040"/>
    <xacro:caster name="rear_left"   parent="base_link" plate_xyz="-0.375 0.243 -0.040"  wheel_xyz="0.025 0 -0.040"/>

    <!-- Instantiate Gantry (Prismatic height axis + spray gun) -->
    <xacro:if value="$(arg attach_gantry)">
        <xacro:gantry parent="base_link" xyz="0 -0.312 0.267" rpy="0 0 -1.5708"/>
    </xacro:if>

    <!-- Instantiate Sensors (IMU, Lidars, Depth Camera, Ultrasonics) -->
    <xacro:if value="$(arg attach_sensors)">
        <xacro:sensors parent="base_link"/>
    </xacro:if>

    <!-- Gazebo Transmission Integration -->
    <xacro:paint_bot_transmission 
        left_wheel="left_wheel_joint" 
        right_wheel="right_wheel_joint" 
        height_paint_position="zAxis_joint" 
        paint_spray_gun="wrist_joint"
       />

    <!-- Gazebo Classic Plugins for Painting Robot Simulation -->
    <gazebo>
        <!-- Differential Drive for Painting Robot Wheels -->
        <plugin name="diff_drive_controller" filename="libgazebo_ros_diff_drive.so">
            <update_rate>50</update_rate>
            <left_joint>left_wheel_joint</left_joint>
            <right_joint>right_wheel_joint</right_joint>
            <wheel_separation>0.576</wheel_separation>
            <wheel_diameter>0.20</wheel_diameter>
            <max_wheel_torque>500.0</max_wheel_torque>
            <max_wheel_acceleration>10.0</max_wheel_acceleration>
            <publish_odom>true</publish_odom>
            <publish_odom_tf>true</publish_odom_tf>
            <publish_wheel_tf>true</publish_wheel_tf>
            <odometry_frame>odom</odometry_frame>
            <robot_base_frame>base_footprint</robot_base_frame>
            <ros>
                <remapping>cmd_vel:=/paint_bot/cmd_vel</remapping>
                <remapping>odom:=/paint_bot/odom</remapping>
            </ros>
        </plugin>

        <!-- Joint State Publisher for all Painting Robot joints -->
        <plugin name="joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
            <update_rate>50</update_rate>
            <joint_name>left_wheel_joint</joint_name>
            <joint_name>right_wheel_joint</joint_name>
            <joint_name>zAxis_joint</joint_name>
            <joint_name>wrist_joint</joint_name>
        </plugin>

        <!-- Prismatic Gantry Joint Pose Trajectory Controller -->
        <plugin name="gantry_pose_controller" filename="libgazebo_ros_joint_pose_trajectory.so">
            <update_rate>50</update_rate>
            <ros>
                <namespace>/paint_axis_controller</namespace>
                <remapping>set_joint_trajectory:=joint_trajectory</remapping>
            </ros>
        </plugin>
    </gazebo>

     <joint name="imu_joint" type="fixed">
        <parent link="base_link"/>
        <child link="imu_link"/>
        <origin xyz="0 0 0.01" rpy="0 0 0"/>
    </joint>

    <link name="imu_link">
        <visual>
            <geometry>
                <box size="0.01 0.01 0.01"/>
            </geometry>
            <material name="black"/>
        </visual>
    </link>

    <gazebo reference="imu_link">
        <sensor name="imu_sensor" type="imu">
            <always_on>true</always_on>
            <update_rate>50</update_rate>
            <imu>
                <angular_velocity>
                    <x><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></x>
                    <y><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></y>
                    <z><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></z>
                </angular_velocity>
                <linear_acceleration>
                    <x><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></x>
                    <y><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></y>
                    <z><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></z>
                </linear_acceleration>
            </imu>
            <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
                <ros>
                    <remapping>~/out:=imu/out</remapping>
                </ros>
                <initial_orientation_as_reference>false</initial_orientation_as_reference>
            </plugin>
        </sensor>
    </gazebo>

</robot>
