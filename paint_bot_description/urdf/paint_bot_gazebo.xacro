<?xml version="1.0" ?>
<robot name="gazebo_properties" xmlns:xacro="http://ros.org/wiki/xacro">
    <!-- Physics properties for stable Gazebo Classic ODE simulation -->
    <gazebo>
        <physics type="ode">
            <real_time_update_rate>1000</real_time_update_rate>
            <max_step_size>0.001</max_step_size>
        </physics>
    </gazebo>
</robot>