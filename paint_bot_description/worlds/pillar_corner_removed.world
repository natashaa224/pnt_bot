<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="pillar_corner_removed">

    <include>
      <uri>model://ground_plane</uri>
    </include>
    <include>
      <uri>model://sun</uri>
    </include>

    <gui>
      <camera name="user_camera">
        <pose>2.8 -7.4 28 0 1.5708 0</pose>
        <projection_type>orthographic</projection_type>
      </camera>
    </gui>

    <!--
      sketch_layout.world with the small jog in the top-right corner (S6/S7) removed.
      The top wall now runs to the long wall (x=5.6) and the long wall runs up to the
      top wall (y=0), giving a plain internal corner. Notch (S2-S4) and pillar unchanged.
      Origin = top-left of the sketch, X right, Y down (negative).
      Pillar 0.46 x 0.9 m, 0.24 m clear gap from the long wall inner face (x=5.525).
    -->
    <model name="pillar_corner_removed_walls">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">

        <!-- S2: west side of notch 1 -->
        <visual name="v_s2"><pose>0 -0.2875 1.5 0 0 0</pose>
          <geometry><box><size>0.15 0.725 3.0</size></box></geometry>
        </visual>
        <collision name="c_s2"><pose>0 -0.2875 1.5 0 0 0</pose>
          <geometry><box><size>0.15 0.725 3.0</size></box></geometry>
        </collision>

        <!-- S3: floor of notch 1 -->
        <visual name="v_s3"><pose>0.45 -0.575 1.5 0 0 0</pose>
          <geometry><box><size>1.05 0.15 3.0</size></box></geometry>
        </visual>
        <collision name="c_s3"><pose>0.45 -0.575 1.5 0 0 0</pose>
          <geometry><box><size>1.05 0.15 3.0</size></box></geometry>
        </collision>

        <!-- S4: east side of notch 1 -->
        <visual name="v_s4"><pose>0.9 -0.2875 1.5 0 0 0</pose>
          <geometry><box><size>0.15 0.725 3.0</size></box></geometry>
        </visual>
        <collision name="c_s4"><pose>0.9 -0.2875 1.5 0 0 0</pose>
          <geometry><box><size>0.15 0.725 3.0</size></box></geometry>
        </collision>

        <!-- S5: top wall, 4.0 m run after notch 1 -->
        <visual name="v_s5"><pose>3.25 0 1.5 0 0 0</pose>
          <geometry><box><size>4.85 0.15 3.0</size></box></geometry>
        </visual>
        <collision name="c_s5"><pose>3.25 0 1.5 0 0 0</pose>
          <geometry><box><size>4.85 0.15 3.0</size></box></geometry>
        </collision>

        <!-- S8: long wall, 15 m (y = +0.075 down to -14.925) -->
        <visual name="v_s8"><pose>5.6 -7.425 1.5 0 0 0</pose>
          <geometry><box><size>0.15 15.0 3.0</size></box></geometry>
        </visual>
        <collision name="c_s8"><pose>5.6 -7.425 1.5 0 0 0</pose>
          <geometry><box><size>0.15 15.0 3.0</size></box></geometry>
        </collision>

        <!-- Block: 1.2 m deep x 1.0 m wide bump-out flush against the long wall inner face (x=5.525) -->
        <visual name="v_block"><pose>4.925 -12.0 1.5 0 0 0</pose>
          <geometry><box><size>1.2 1.0 3.0</size></box></geometry>
        </visual>
        <collision name="c_block"><pose>4.925 -12.0 1.5 0 0 0</pose>
          <geometry><box><size>1.2 1.0 3.0</size></box></geometry>
        </collision>

        <!-- Pillar: free-standing bump-out near the long wall -->
        <visual name="v_pillar"><pose>5.055 -5.575 1.5 0 0 0</pose>
          <geometry><box><size>0.46 0.9 3.0</size></box></geometry>
        </visual>
        <collision name="c_pillar"><pose>5.055 -5.575 1.5 0 0 0</pose>
          <geometry><box><size>0.46 0.9 3.0</size></box></geometry>
        </collision>

      </link>
    </model>

  </world>
</sdf>
