<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="external_corner_stub">

    <include>
      <uri>model://ground_plane</uri>
    </include>
    <include>
      <uri>model://sun</uri>
    </include>

    <!--
      Minimal external-corner test world.
      Removed the enclosing/front/back/left/right clutter walls.

      Geometry intent:
        - long_approach_wall: the wall the robot follows before the external corner
        - corner_return_wall: short perpendicular return forming the external terminal/corner

      Adjust long_approach_wall size Y if you want even more walking room.
    -->
    <model name="external_corner_test_wall">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">

        <!-- Long wall section before the external corner: widened/lengthened -->
        <visual name="v_long_approach_wall">
          <pose>0 4.0 1.5 0 0 0</pose>
          <geometry>
            <box>
              <size>0.9 1.4 3.0</size>
            </box>
          </geometry>
        </visual>
        <collision name="c_long_approach_wall">
          <pose>0 4.0 1.5 0 0 0</pose>
          <geometry>
            <box>
              <size>0.9 1.4 3.0</size>
            </box>
          </geometry>
        </collision>

        <!-- Perpendicular return wall at the end, creating the external corner -->
        <visual name="v_corner_return_wall">
          <pose>0 4.25 1.5 0 0 0</pose>
          <geometry>
            <box>
              <size>15 0.5 3.0</size>
            </box>
          </geometry>
        </visual>
        <collision name="c_corner_return_wall">
          <pose>0 4.25 1.5 0 0 0</pose>
          <geometry>
            <box>
              <size>15 0.5 3.0</size>
            </box>
          </geometry>
        </collision>

      </link>
    </model>

  </world>
</sdf>
