<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="wall_obstacle_world">

    <!-- Physics settings -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- Sun / Primary light -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Ground plane -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Additional Ambient Lighting for Wall Inspection -->
    <light name="fill_light_1" type="point">
      <pose>1.5 -0.2 3.0 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>20</range>
        <constant>0.5</constant>
        <linear>0.05</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <light name="fill_light_2" type="point">
      <pose>4.5 -0.2 3.0 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>20</range>
        <constant>0.5</constant>
        <linear>0.05</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <!-- Initial GUI Camera View: Looking at Robot and Wall -->
    <gui>
      <camera name="user_camera">
        <pose>-1.8 1.8 2.2 0 0.45 -0.65</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

    <!-- ================================================================= -->
    <!-- INSPECTION WALL SYSTEM                                            -->
    <!-- Baseline wall surface inner face is at Y = -0.750 m               -->
    <!-- Thickness: 0.15 m -> Wall Center at Y = -0.825 m                  -->
    <!-- Height: 2.50 m                                                    -->
    <!-- ================================================================= -->
    <model name="inspection_wall_system">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>

      <link name="wall_link">

        <!-- Section A: Wall before cutout (from X = -3.5 to X = -2.2) -->
        <collision name="col_wall_a">
          <pose>-2.85 -0.825 1.25 0 0 0</pose>
          <geometry><box><size>1.30 0.15 2.50</size></box></geometry>
        </collision>
        <visual name="vis_wall_a">
          <pose>-2.85 -0.825 1.25 0 0 0</pose>
          <geometry><box><size>1.30 0.15 2.50</size></box></geometry>
          <material>
            <ambient>0.82 0.82 0.82 1.0</ambient>
            <diffuse>0.85 0.85 0.85 1.0</diffuse>
          </material>
        </visual>

        <!-- Cutout Sill / Lintel: Wall below and above window cutout (X = -2.2 to -1.4) -->
        <!-- Below opening (Z = 0.0 to 0.45) -->
        <collision name="col_wall_window_sill">
          <pose>-1.80 -0.825 0.225 0 0 0</pose>
          <geometry><box><size>0.80 0.15 0.45</size></box></geometry>
        </collision>
        <visual name="vis_wall_window_sill">
          <pose>-1.80 -0.825 0.225 0 0 0</pose>
          <geometry><box><size>0.80 0.15 0.45</size></box></geometry>
          <material>
            <ambient>0.82 0.82 0.82 1.0</ambient>
            <diffuse>0.85 0.85 0.85 1.0</diffuse>
          </material>
        </visual>

        <!-- Above opening (Z = 1.65 to 2.50) -->
        <collision name="col_wall_window_top">
          <pose>-1.80 -0.825 2.075 0 0 0</pose>
          <geometry><box><size>0.80 0.15 0.85</size></box></geometry>
        </collision>
        <visual name="vis_wall_window_top">
          <pose>-1.80 -0.825 2.075 0 0 0</pose>
          <geometry><box><size>0.80 0.15 0.85</size></box></geometry>
          <material>
            <ambient>0.82 0.82 0.82 1.0</ambient>
            <diffuse>0.85 0.85 0.85 1.0</diffuse>
          </material>
        </visual>

        <!-- Section B1a: Wall from X = -1.4 to X = +1.25 (length = 2.65m, center = -0.075m) -->
        <collision name="col_wall_b1a">
          <pose>-0.075 -0.825 1.25 0 0 0</pose>
          <geometry><box><size>2.65 0.15 2.50</size></box></geometry>
        </collision>
        <visual name="vis_wall_b1a">
          <pose>-0.075 -0.825 1.25 0 0 0</pose>
          <geometry><box><size>2.65 0.15 2.50</size></box></geometry>
          <material>
            <ambient>0.82 0.82 0.82 1.0</ambient>
            <diffuse>0.85 0.85 0.85 1.0</diffuse>
          </material>
        </visual>

        <!-- Section B1b: Wall after doorway from X = 2.15 to X = 2.20 (length = 0.05m) -->
        <collision name="col_wall_b1b">
          <pose>2.175 -0.825 1.25 0 0 0</pose>
          <geometry><box><size>0.05 0.15 2.50</size></box></geometry>
        </collision>
        <visual name="vis_wall_b1b">
          <pose>2.175 -0.825 1.25 0 0 0</pose>
          <geometry><box><size>0.05 0.15 2.50</size></box></geometry>
          <material>
            <ambient>0.82 0.82 0.82 1.0</ambient>
            <diffuse>0.85 0.85 0.85 1.0</diffuse>
          </material>
        </visual>

        <!-- Window Cutout 2: From X = 2.2 to X = 3.0 (width 0.80m, center = 2.60m) -->
        <!-- Below window opening (Z = 0.0 to 0.50m) -->
        <collision name="col_window2_sill">
          <pose>2.60 -0.825 0.25 0 0 0</pose>
          <geometry><box><size>0.80 0.15 0.50</size></box></geometry>
        </collision>
        <visual name="vis_window2_sill">
          <pose>2.60 -0.825 0.25 0 0 0</pose>
          <geometry><box><size>0.80 0.15 0.50</size></box></geometry>
          <material>
            <ambient>0.82 0.82 0.82 1.0</ambient>
            <diffuse>0.85 0.85 0.85 1.0</diffuse>
          </material>
        </visual>

        <!-- Above window opening (Z = 1.70 to 2.50m) -->
        <collision name="col_window2_top">
          <pose>2.60 -0.825 2.10 0 0 0</pose>
          <geometry><box><size>0.80 0.15 0.80</size></box></geometry>
        </collision>
        <visual name="vis_window2_top">
          <pose>2.60 -0.825 2.10 0 0 0</pose>
          <geometry><box><size>0.80 0.15 0.80</size></box></geometry>
          <material>
            <ambient>0.82 0.82 0.82 1.0</ambient>
            <diffuse>0.85 0.85 0.85 1.0</diffuse>
          </material>
        </visual>

        <!-- Section B2: Wall from X = 3.0 to X = +7.0 (length = 4.0m, center = 5.00m) -->
        <collision name="col_wall_b2">
          <pose>5.00 -0.825 1.25 0 0 0</pose>
          <geometry><box><size>4.00 0.15 2.50</size></box></geometry>
        </collision>
        <visual name="vis_wall_b2">
          <pose>5.00 -0.825 1.25 0 0 0</pose>
          <geometry><box><size>4.00 0.15 2.50</size></box></geometry>
          <material>
            <ambient>0.82 0.82 0.82 1.0</ambient>
            <diffuse>0.85 0.85 0.85 1.0</diffuse>
          </material>
        </visual>

        <!-- Baseboard strip along wall bottom (for visual contrast) -->
        <visual name="vis_wall_baseboard">
          <pose>2.0 -0.745 0.05 0 0 0</pose>
          <geometry><box><size>10.0 0.02 0.10</size></box></geometry>
          <material>
            <ambient>0.25 0.25 0.28 1.0</ambient>
            <diffuse>0.30 0.30 0.33 1.0</diffuse>
          </material>
        </visual>

        <!-- =============================================================== -->
        <!-- WALL SURFACE OBSTACLES: Realistic Configurable Wall Elements    -->
        <!-- Baseline wall inner surface is at Y = -0.750 m                  -->
        <!-- =============================================================== -->

        <!-- OBSTACLE 1: Switchboard (Test 2)                                 -->
        <!-- Protruding 0.04 m from baseline (faces at Y = -0.710 m)          -->
        <!-- Width: 0.15 m, Height: 0.15 m, Center Z: 0.85 m                  -->
        <collision name="col_switchboard_1">
          <pose>-0.70 -0.730 0.85 0 0 0</pose>
          <geometry><box><size>0.15 0.04 0.15</size></box></geometry>
        </collision>
        <visual name="vis_switchboard_1_body">
          <pose>-0.70 -0.730 0.85 0 0 0</pose>
          <geometry><box><size>0.15 0.04 0.15</size></box></geometry>
          <material>
            <ambient>0.92 0.90 0.85 1.0</ambient>
            <diffuse>0.95 0.93 0.88 1.0</diffuse>
          </material>
        </visual>
        <visual name="vis_switchboard_1_switches">
          <pose>-0.70 -0.708 0.85 0 0 0</pose>
          <geometry><box><size>0.08 0.005 0.04</size></box></geometry>
          <material>
            <ambient>0.15 0.15 0.15 1.0</ambient>
            <diffuse>0.20 0.20 0.20 1.0</diffuse>
          </material>
        </visual>

        <!-- OBSTACLE 2: Shallow Wall-Mounted Electrical Box (Junction Box)  -->
        <!-- Protruding 0.06 m from baseline (faces at Y = -0.690 m)          -->
        <!-- Width: 0.25 m, Height: 0.22 m, Center Z: 0.95 m                  -->
        <collision name="col_electrical_box">
          <pose>0.00 -0.720 0.95 0 0 0</pose>
          <geometry><box><size>0.25 0.06 0.22</size></box></geometry>
        </collision>
        <visual name="vis_electrical_box_body">
          <pose>0.00 -0.720 0.95 0 0 0</pose>
          <geometry><box><size>0.25 0.06 0.22</size></box></geometry>
          <material>
            <ambient>0.28 0.35 0.42 1.0</ambient>
            <diffuse>0.35 0.45 0.55 1.0</diffuse>
          </material>
        </visual>
        <visual name="vis_electrical_box_badge">
          <pose>0.00 -0.688 0.95 0 0 0</pose>
          <geometry><box><size>0.09 0.005 0.06</size></box></geometry>
          <material>
            <ambient>0.95 0.75 0.10 1.0</ambient>
            <diffuse>0.98 0.80 0.12 1.0</diffuse>
          </material>
        </visual>

        <!-- OBSTACLE 3: Minor Wall Protrusion (Test 3)                       -->
        <!-- Shallow surface projection: 0.035 m (3.5 cm)                     -->
        <!-- Width: 0.10 m, Height: 0.10 m, Center Z: 0.65 m                  -->
        <collision name="col_minor_protrusion">
          <pose>0.60 -0.7325 0.65 0 0 0</pose>
          <geometry><box><size>0.10 0.035 0.10</size></box></geometry>
        </collision>
        <visual name="vis_minor_protrusion">
          <pose>0.60 -0.7325 0.65 0 0 0</pose>
          <geometry><box><size>0.10 0.035 0.10</size></box></geometry>
          <material>
            <ambient>0.65 0.40 0.20 1.0</ambient>
            <diffuse>0.75 0.48 0.25 1.0</diffuse>
          </material>
        </visual>

        <!-- OBSTACLE 4: Vertical Conduit Pipe (at X = 1.0 m)                -->
        <!-- Protruding 0.08 m from wall                                      -->
        <collision name="col_obs2_conduit">
          <pose>1.00 -0.710 1.25 0 0 0</pose>
          <geometry><box><size>0.08 0.08 2.50</size></box></geometry>
        </collision>
        <visual name="vis_obs2_conduit">
          <pose>1.00 -0.710 1.25 0 0 0</pose>
          <geometry><cylinder><radius>0.04</radius><length>2.50</length></cylinder></geometry>
          <material>
            <ambient>0.85 0.45 0.1 1.0</ambient>
            <diffuse>0.90 0.50 0.12 1.0</diffuse>
          </material>
        </visual>

        <!-- =============================================================== -->
        <!-- DOORWAY OPENING: X = 1.50 m (width: 0.90 m, Z: 0.0 to 2.10 m)   -->
        <!-- Section above Doorway Lintel: Z = 2.10 to 2.50 m                 -->
        <!-- =============================================================== -->
        <collision name="col_doorway_lintel">
          <pose>1.70 -0.825 2.30 0 0 0</pose>
          <geometry><box><size>0.90 0.15 0.40</size></box></geometry>
        </collision>
        <visual name="vis_doorway_lintel">
          <pose>1.70 -0.825 2.30 0 0 0</pose>
          <geometry><box><size>0.90 0.15 0.40</size></box></geometry>
          <material>
            <ambient>0.82 0.82 0.82 1.0</ambient>
            <diffuse>0.85 0.85 0.85 1.0</diffuse>
          </material>
        </visual>
        <!-- Door Frame outline -->
        <visual name="vis_door_frame_left">
          <pose>1.24 -0.745 1.05 0 0 0</pose>
          <geometry><box><size>0.03 0.02 2.10</size></box></geometry>
          <material><ambient>0.3 0.2 0.1 1</ambient><diffuse>0.4 0.25 0.15 1</diffuse></material>
        </visual>
        <visual name="vis_door_frame_right">
          <pose>2.16 -0.745 1.05 0 0 0</pose>
          <geometry><box><size>0.03 0.02 2.10</size></box></geometry>
          <material><ambient>0.3 0.2 0.1 1</ambient><diffuse>0.4 0.25 0.15 1</diffuse></material>
        </visual>

        <!-- =============================================================== -->
        <!-- MULTI-OBSTACLE SECTION (Test 4): Window + Multiple Switchboards  -->
        <!-- Centered around X = 3.5 m                                        -->
        <!-- =============================================================== -->
        <!-- Switchboard below Window 2: X = 2.60 m, Z = 0.25 m               -->
        <collision name="col_multi_switchboard_1">
          <pose>2.60 -0.730 0.25 0 0 0</pose>
          <geometry><box><size>0.15 0.04 0.15</size></box></geometry>
        </collision>
        <visual name="vis_multi_switchboard_1">
          <pose>2.60 -0.730 0.25 0 0 0</pose>
          <geometry><box><size>0.15 0.04 0.15</size></box></geometry>
          <material>
            <ambient>0.95 0.95 0.95 1.0</ambient>
            <diffuse>0.98 0.98 0.98 1.0</diffuse>
          </material>
        </visual>

        <!-- Switchboard on Wall Column: X = 3.50 m, Z = 0.90 m               -->
        <collision name="col_multi_switchboard_2">
          <pose>3.50 -0.615 0.90 0 0 0</pose>
          <geometry><box><size>0.14 0.04 0.14</size></box></geometry>
        </collision>
        <visual name="vis_multi_switchboard_2">
          <pose>3.50 -0.615 0.90 0 0 0</pose>
          <geometry><box><size>0.14 0.04 0.14</size></box></geometry>
          <material>
            <ambient>0.95 0.70 0.20 1.0</ambient>
            <diffuse>0.98 0.75 0.22 1.0</diffuse>
          </material>
        </visual>

        <!-- =============================================================== -->
        <!-- WALL SURFACE OBSTACLE 3: Wall Column Bump-out (at X = 3.5 m)    -->
        <!-- Structural pilaster protruding 0.22 m from baseline             -->
        <!-- =============================================================== -->
        <collision name="col_obs3_column">
          <pose>3.50 -0.64 1.25 0 0 0</pose>
          <geometry><box><size>0.60 0.22 2.50</size></box></geometry>
        </collision>
        <visual name="vis_obs3_column">
          <pose>3.50 -0.64 1.25 0 0 0</pose>
          <geometry><box><size>0.60 0.22 2.50</size></box></geometry>
          <material>
            <ambient>0.4 0.42 0.45 1.0</ambient>
            <diffuse>0.5 0.52 0.56 1.0</diffuse>
          </material>
        </visual>

        <!-- =============================================================== -->
        <!-- WALL SURFACE OBSTACLE 4: Fire Safety Cabinet (at X = 5.2 m)     -->
        <!-- Red cabinet protruding 0.18 m                                   -->
        <!-- =============================================================== -->
        <collision name="col_obs4_fire_cabinet">
          <pose>5.20 -0.66 0.90 0 0 0</pose>
          <geometry><box><size>0.28 0.18 0.65</size></box></geometry>
        </collision>
        <visual name="vis_obs4_fire_cabinet">
          <pose>5.20 -0.66 0.90 0 0 0</pose>
          <geometry><box><size>0.28 0.18 0.65</size></box></geometry>
          <material>
            <ambient>0.85 0.12 0.12 1.0</ambient>
            <diffuse>0.90 0.15 0.15 1.0</diffuse>
          </material>
        </visual>

        <!-- Corridor Back Wall (at Y = +1.8 m) -->
        <collision name="col_corridor_back">
          <pose>1.80 1.80 1.25 0 0 0</pose>
          <geometry><box><size>10.60 0.15 2.50</size></box></geometry>
        </collision>
        <visual name="vis_corridor_back">
          <pose>1.80 1.80 1.25 0 0 0</pose>
          <geometry><box><size>10.60 0.15 2.50</size></box></geometry>
          <material>
            <ambient>0.75 0.75 0.75 1.0</ambient>
            <diffuse>0.78 0.78 0.78 1.0</diffuse>
          </material>
        </visual>

        <!-- Corridor End Wall Left (at X = -3.5 m) -->
        <collision name="col_corridor_left">
          <pose>-3.50 0.4875 1.25 0 0 0</pose>
          <geometry><box><size>0.15 2.775 2.50</size></box></geometry>
        </collision>
        <visual name="vis_corridor_left">
          <pose>-3.50 0.4875 1.25 0 0 0</pose>
          <geometry><box><size>0.15 2.775 2.50</size></box></geometry>
          <material>
            <ambient>0.75 0.75 0.75 1.0</ambient>
            <diffuse>0.78 0.78 0.78 1.0</diffuse>
          </material>
        </visual>

        <!-- Corridor End Wall Right (at X = +7.1 m) -->
        <collision name="col_corridor_right">
          <pose>7.10 0.4875 1.25 0 0 0</pose>
          <geometry><box><size>0.15 2.775 2.50</size></box></geometry>
        </collision>
        <visual name="vis_corridor_right">
          <pose>7.10 0.4875 1.25 0 0 0</pose>
          <geometry><box><size>0.15 2.775 2.50</size></box></geometry>
          <material>
            <ambient>0.75 0.75 0.75 1.0</ambient>
            <diffuse>0.78 0.78 0.78 1.0</diffuse>
          </material>
        </visual>

      </link>
    </model>

  </world>
</sdf>
