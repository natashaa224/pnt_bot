    <!--
    ================================================================
      DOORS (2 total) — using door_3d mesh
      Door opening: 1.0m wide x 2.1m tall
      Door local frame: mesh origin at bottom-left of door panel.
      We wrap each door in a wood frame + the mesh.

      ROTATION RULES (door local +X faces INTO the room, same as windows):
        Back wall  door at x=+2.0, y=+5.0: rot=-pi/2  (local+X → world -Y = into room)
        Front wall door at x=-2.0, y=-5.0: rot=+pi/2  (local+X → world +Y = into room)
    ================================================================
    -->

    <!-- ── DOOR 1: Back wall, x=+2.0 — CLOSED door panel ── -->
    <!--
      Back wall inner face: y=+5.0
      Door opening: x=1.5..2.5 (1m wide), z=0..2.1
      Door sits flush with inner face (y=5.0), panel thickness 0.06m
      rot=-pi/2 so local +X faces into room (-Y world)
    -->
    <model name='door_1'>
      <static>1</static>
      <pose>2.0 7.5 0 0 0 -1.5708</pose>
      <link name='link'>
        <!-- wood frame top -->
        <visual name='ft'><pose>0 0 2.17 0 0 0</pose>
          <geometry><box><size>0.10 1.10 0.08</size></box></geometry>
          <material><ambient>0.32 0.24 0.15 1</ambient><diffuse>0.38 0.28 0.17 1</diffuse><specular>0.05 0.05 0.05 1</specular></material>
        </visual>
        <collision name='cft'><pose>0 0 2.17 0 0 0</pose>
          <geometry><box><size>0.10 1.10 0.08</size></box></geometry></collision>
        <!-- wood frame left side -->
        <visual name='fl'><pose>0 -0.52 1.05 0 0 0</pose>
          <geometry><box><size>0.10 0.08 2.10</size></box></geometry>
          <material><ambient>0.32 0.24 0.15 1</ambient><diffuse>0.38 0.28 0.17 1</diffuse><specular>0.05 0.05 0.05 1</specular></material>
        </visual>
        <collision name='cfl'><pose>0 -0.52 1.05 0 0 0</pose>
          <geometry><box><size>0.10 0.08 2.10</size></box></geometry></collision>
        <!-- wood frame right side -->
        <visual name='fr'><pose>0 0.52 1.05 0 0 0</pose>
          <geometry><box><size>0.10 0.08 2.10</size></box></geometry>
          <material><ambient>0.32 0.24 0.15 1</ambient><diffuse>0.38 0.28 0.17 1</diffuse><specular>0.05 0.05 0.05 1</specular></material>
        </visual>
        <collision name='cfr'><pose>0 0.52 1.05 0 0 0</pose>
          <geometry><box><size>0.10 0.08 2.10</size></box></geometry></collision>
        <!-- door panel (closed, flush with wall inner face) -->
        <visual name='panel'><pose>0.03 0 1.05 0 0 0</pose>
          <geometry><box><size>0.06 0.90 2.08</size></box></geometry>
          <material><ambient>0.48 0.34 0.20 1</ambient><diffuse>0.52 0.38 0.22 1</diffuse><specular>0.08 0.07 0.05 1</specular></material>
        </visual>
        <collision name='cpanel'><pose>0.03 0 1.05 0 0 0</pose>
          <geometry><box><size>0.06 0.90 2.08</size></box></geometry></collision>
        <!-- door panel top rail -->
        <visual name='rail_t'><pose>0.04 0 1.88 0 0 0</pose>
          <geometry><box><size>0.07 0.88 0.20</size></box></geometry>
          <material><ambient>0.40 0.28 0.16 1</ambient><diffuse>0.44 0.32 0.19 1</diffuse></material>
        </visual>
        <!-- door panel bottom rail -->
        <visual name='rail_b'><pose>0.04 0 0.15 0 0 0</pose>
          <geometry><box><size>0.07 0.88 0.22</size></box></geometry>
          <material><ambient>0.40 0.28 0.16 1</ambient><diffuse>0.44 0.32 0.19 1</diffuse></material>
        </visual>
        <!-- door panel middle rail -->
        <visual name='rail_m'><pose>0.04 0 1.05 0 0 0</pose>
          <geometry><box><size>0.07 0.88 0.08</size></box></geometry>
          <material><ambient>0.40 0.28 0.16 1</ambient><diffuse>0.44 0.32 0.19 1</diffuse></material>
        </visual>
        <!-- door handle (knob) — room side -->
        <visual name='knob'><pose>0.07 0.35 1.05 0 0 0</pose>
